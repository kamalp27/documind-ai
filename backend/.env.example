# Application Configuration
PROJECT_NAME="DocuMind AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Server Configuration
HOST="127.0.0.1"
PORT=8000

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Document Processing & Ingestion
MAX_UPLOAD_SIZE_BYTES=10485760
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Embedding Model
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"

# Local Storage (relative to backend/)
DATA_DIR="data"
CHROMA_PERSIST_DIR="data/chroma"
DOCUMENTS_METADATA_FILE="data/documents_metadata.json"
CHROMA_COLLECTION_NAME="documind_documents"
